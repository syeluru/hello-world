# Google showtimes via SerpApi (https://serpapi.com/manage-api-key). Without it the server serves sample data.
SERPAPI_KEY=
# The Movie Database v3 key (https://www.themoviedb.org/settings/api) for runtimes and posters. Optional.
TMDB_API_KEY=
# Time zone the theatres live in; "today" is computed here.
THEATRE_TZ=America/Chicago
# Server port (Vite proxies /api here in development).
PORT=8787
# How long a fetched day is cached in memory.
CACHE_TTL_MINUTES=15
