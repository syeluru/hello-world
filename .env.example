# Supabase — from your project's Settings > API
# Without these the app runs in local demo mode (data stays in your browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Meal analysis backend — how "what I just ate" gets turned into calories/macros.
#   cli  (default) : shells out to `claude -p` (Claude Code headless mode).
#                    Uses your Claude subscription login — no API key needed.
#                    Works wherever the `claude` CLI is installed and signed in,
#                    i.e. the machine you self-host on.
#   api            : calls the Anthropic API directly. Needs ANTHROPIC_API_KEY.
#                    Only for hosting somewhere without the claude CLI.
# Leave unset to auto-pick: api if ANTHROPIC_API_KEY is set, otherwise cli.
MEAL_PARSER=

# Only needed for MEAL_PARSER=api
ANTHROPIC_API_KEY=
