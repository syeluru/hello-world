# Optional: cross-device sync via Supabase.
# Without these the app stores everything in the browser (localStorage) and
# works fully offline. With them, the app document is mirrored to a single
# row in the `app_state` table so your phone and laptop stay in sync.
#
# Get both values from your Supabase project: Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
