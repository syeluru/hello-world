# Shared secret the phone sends as "Authorization: Bearer <token>"
EXPANDER_TOKEN=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=sk-ant-...
# From get_google_token.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Comma-separated; "primary" is your main Google calendar
GOOGLE_CALENDAR_IDS=primary
USER_TIMEZONE=America/New_York
WORK_START_HOUR=9
WORK_END_HOUR=18
MIN_SLOT_MINUTES=30
# Optional overrides
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=low

# --- Slack (Basic Information → App Credentials / OAuth & Permissions) ---
SLACK_SIGNING_SECRET=
# Bot token (xoxb-...), used to look up your Slack time zone
SLACK_BOT_TOKEN=
# User token (xoxp-...). With it, "Send" posts as you. Without it, the post comes from the app.
SLACK_USER_TOKEN=
# Your Slack member ID(s). Anyone else gets "this command is private". Strongly recommended.
SLACK_ALLOWED_USER_IDS=
