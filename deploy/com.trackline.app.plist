<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- macOS LaunchAgent for Trackline.
       Install:
         cp deploy/com.trackline.app.plist ~/Library/LaunchAgents/
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.trackline.app.plist
       It runs as your user via a login shell, so node/npm/claude from
       Homebrew are on PATH (nvm users: add `source ~/.nvm/nvm.sh` to
       ~/.zprofile or hardcode the npm path below).
       Assumes the repo is cloned at ~/fitness-nutrition-tracker — edit the
       cd path if yours differs. -->
  <key>Label</key>
  <string>com.trackline.app</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "$HOME/fitness-nutrition-tracker" &amp;&amp; exec npm run start</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/trackline.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/trackline.err.log</string>
</dict>
</plist>
