# Copy to secrets.yaml (same directory) and fill in. Never commit secrets.yaml.
wifi_ssid: "YourWifiName"
wifi_password: "your-wifi-password"

# Generate with: openssl rand -base64 32   (or via https://esphome.io/components/api.html)
api_encryption_key: "GENERATE-A-BASE64-32-BYTE-KEY"

ota_password: "pick-a-strong-ota-password"
